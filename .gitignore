# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# local example files
/example-data/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# local planning notes — only README.md is tracked in this repo
/plan-*.md
/plan-*.markdown

# sanity dataset backups + content snapshots (local only, never push)
/backups/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
