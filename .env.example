# PRECEDENCE
# Local values live in .env.local. Next and Bun read that file themselves; plain
# node does not, which is why scripts that run under node call
# scripts/env-local.mjs. Nothing here tries to out-rank your shell: the database
# variable is named DB_URL precisely so it cannot collide with a DATABASE_URL that
# some other project on your machine exports (see below).
#
# Public production URL, without a trailing slash
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Added during the Sanity integration phase
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
SANITY_REVALIDATE_SECRET=
SANITY_PREVIEW_SECRET=

# --- Lab: Daily Questions -----------------------------------------------
# Neon Postgres, app traffic. Use the POOLED host ("-pooler" in the name):
# serverless-friendly, and up to 10k concurrent client connections.
#
# WHY NOT DATABASE_URL: that name is what PaaS integrations inject, so on a
# machine that has other projects it is contested, and whichever value the runtime
# happened to pick won silently. A distinct name removes the collision instead of
# trying to out-rank it. The cost is that an integration injecting DATABASE_URL
# will not be picked up until you point DB_URL at it — a loud failure rather than
# a silent wrong database.
DB_URL=

# Neon Postgres, migrations only. Use the DIRECT host (no "-pooler"): the pooled
# endpoint is PgBouncer in transaction mode, which Neon advises against for schema
# changes. Optional — db:migrate falls back to DB_URL. Not contested, so the
# conventional name is fine here.
DIRECT_URL=

# OmniRoute gateway used to generate one question per UTC day.
# OpenAI-compatible: POST {base}/v1/chat/completions
OMNIROUTE_BASE_URL=https://omniroute.vps.relpenasal.org
OMNIROUTE_API_KEY=
# Measured with this feature's request body: auto 54s, auto/cheap 34s,
# auto/fast 14s, auto/smart 17s. auto is the slowest of them.
OMNIROUTE_MODEL=auto/smart

# Random string. Salts the IP hash used for rate limiting so the stored value
# is not a reversible hash of an address.
RATE_LIMIT_SALT=

# --- Lab: Daily Questions — web push -------------------------------------
# Generate once with: node -e 'console.log(require("web-push").generateVAPIDKeys())'
# The public key is handed to the browser so it can subscribe; the private key signs
# the push and never leaves the server. SUBJECT is a contact URI that push services
# require per the VAPID spec. Leave any of these blank and notifications turn off
# cleanly — the tool works without them, it just cannot nudge anyone.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
